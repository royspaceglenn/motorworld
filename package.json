{
  "name": "motor-world-auto-services-sales",
  "description": "Motor World Auto Services & Sales Corporation — inventory, purchasing, POS, receivables, and operations.",
  "author": "Motor World Auto Services & Sales Corporation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "setup": "node scripts/setup-dev.mjs",
    "cache:clean": "node scripts/clean-vite-cache.mjs",
    "desktop:start": "npm run predesktop:dev && npm run desktop:dev",
    "dev": "concurrently \"npm run dev:server\" \"vite\"",
    "dev:live": "vite",
    "dev:live:setup": "node scripts/use-live-api-dev.mjs",
    "dev:frontend": "vite",
    "dev:server": "npm run rebuild:server-sqlite && npm --prefix server run dev",
    "build": "vite build",
    "viewer:build": "vite build",
    "viewer:cap:build": "vite build --config vite.viewer.config.ts && node scripts/viewer-cap-sync.mjs",
    "viewer:cap:sync": "npm run viewer:cap:build && npx cap sync android",
    "flutter:viewer:apk": "cd flutter_viewer && flutter pub get && flutter build apk --release",
    "viewer:deploy": "npm run viewer:build && firebase deploy --only hosting",
    "rebuild:server-sqlite": "node scripts/ensure-server-sqlite.mjs",
    "predesktop:dev": "node scripts/ensure-server-sqlite.mjs",
    "desktop:dev": "concurrently \"npm run dev:frontend\" \"wait-on tcp:5174 && electron .\"",
    "desktop:installers:configure": "node scripts/write-bundled-api.mjs",
    "desktop:installers:clear": "node scripts/write-bundled-api.mjs --clear",
    "desktop:pack": "npm run build && npm run rebuild:server-sqlite && node scripts/run-electron-builder-win.mjs --dir",
    "desktop:pack:no-sqlite": "npm run build && node scripts/run-electron-builder-win.mjs --dir",
    "desktop:build": "npm run build && npm run rebuild:server-sqlite && node scripts/run-electron-builder-win.mjs --nsis",
    "desktop:build:no-sqlite": "npm run build && node scripts/run-electron-builder-win.mjs --nsis",
    "desktop:installer": "npm run desktop:build",
    "preview": "vite preview",
    "firebase:seed-users": "node scripts/seed-firebase-users.mjs",
    "firebase:migrate-data": "node scripts/migrate-to-firebase.mjs",
    "firebase:functions:check": "node --check functions/index.js"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.4",
    "@google/genai": "^1.41.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "firebase-functions": "^7.2.5",
    "html2pdf.js": "^0.10.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.motorworld.desktop",
    "productName": "Motor World Auto Services & Sales Corporation",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "!server/data/**/*",
      "!server/backups/**/*",
      "!server/.env",
      "!server/.env.*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "server/**/*"
    ],
    "win": {
      "executableName": "MotorWorld-AutoServices",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
