{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/viewer", "dest": "/viewer.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
