# Copy to `.env.development.local` (gitignored) so local dev shows the SAME data as the live site.
#   copy .env.development.local.example .env.development.local
# Then run:  npm run dev:live
#
# Required on Render → motorworld-api → Environment:
#   MOTOR_WORLD_ORIGINS=...,http://localhost:5174,http://127.0.0.1:5174
# (include your production https:// URLs too)

VITE_DATA_BACKEND=rest
VITE_API_BASE_URL=https://motorworld-api.onrender.com
