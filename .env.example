# Local desktop dev (simplest): keep VITE_DATA_BACKEND=rest, leave VITE_API_BASE_URL empty,
# run once: npm run setup   then daily: npm run desktop:start
VITE_DATA_BACKEND=rest
# Vite dev server port (browser + Electron dev). Default 5174. Keep in sync with wait-on in package.json "desktop:dev".
VITE_DEV_SERVER_PORT=5174
# Use `firebase` for Firestore + Auth + Functions (offline cache + realtime listeners). Requires all VITE_FIREBASE_* vars.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_SHOP_ID=main
# Leave empty for local API (npm run dev) and packaged desktop.
# For the SAME data as the live site while coding, copy .env.development.local.example
# to .env.development.local and run: npm run dev:live
VITE_API_BASE_URL=

# Backward-compatible fallback used by the standalone viewer if VITE_FIREBASE_SHOP_ID is not set.
VITE_FIREBASE_VIEWER_SHOP_ID=main

# Backend Firestore mirror: filename in project root, or path relative to project root / app data.
# Example file next to package.json: my-project-firebase-adminsdk-xxxxx.json
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=my-project-firebase-adminsdk-xxxxx.json

# Alternatively provide the full JSON in one line (avoid committing it).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# API (add these to the project root `.env` so the backend picks them up when cwd is the project root)
PORT=3001
# Login token signing key (alias: JWT_SECRET). Use ≥32 random chars in production.
MOTOR_WORLD_APP_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
SQLITE_DB_PATH=./server/data/motorworld.sqlite
FIREBASE_VIEWER_SHOP_ID=main

# --- Neon / Postgres (required for Vercel serverless API; optional locally) ---
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Production API (Vercel env + any hosted Node) ---
# NODE_ENV=production
# MOTOR_WORLD_ORIGINS=https://your-frontend.example.com
# (alias: CORS_ORIGINS)
# TRUST_PROXY=1
# Never set ALLOW_UNAUTHENTICATED_API=true on the public internet.
